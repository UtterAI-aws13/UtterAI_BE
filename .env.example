APP_NAME=UtterAI Functional Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1

DB_USER=utterai
DB_PASSWORD=utterai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=utterai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS_ENABLED=false

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

INTERNAL_CALLBACK_TOKEN=change-me-internal-token

AI_SERVICE_BASE_URL=
AI_SERVICE_ANALYSIS_PATH=/internal/ai/analysis-jobs

AWS_REGION=ap-northeast-2
S3_BUCKET_AUDIO=utterai-dev-raw-audio
S3_BUCKET_TEMPLATE=utterai-dev-template
S3_BUCKET_TRANSCRIPT=utterai-dev-transcripts
PRESIGNED_URL_EXPIRE_SECONDS=900

SQS_AUDIO_PREPROCESS_QUEUE_URL=
SQS_REPORT_ANALYSIS_QUEUE_URL=

OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,team=utterai

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]