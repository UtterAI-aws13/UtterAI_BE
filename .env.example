APP_NAME=UtterAI Functional Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1

DB_USER=utterai
DB_PASSWORD=utterai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=utterai

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

INTERNAL_CALLBACK_TOKEN=change-me-internal-token
INTERNAL_CALLBACK_HMAC_SECRET=change-me-hmac-secret

AWS_REGION=ap-northeast-2
RAW_AUDIO_BUCKET=utterai-raw-audio
PRESIGNED_URL_EXPIRE_SECONDS=900

SQS_AUDIO_PREPROCESS_QUEUE_URL=
PUBLIC_API_BASE_URL=http://localhost:8000

OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,team=utterai
